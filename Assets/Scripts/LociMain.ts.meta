  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">LociMain – memory-palace flow: build, study, quiz, results</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject cameraObject {\"hint\":\"The world camera (Camera Object) — the user's eyes\"}"
    - "// @input SceneObject palaceRoot {\"hint\":\"Room root: floor under the user's feet; stand-ins, spots and UI are children\"}"
    - '// @input AssignableType_1 shapeKit {"hint":"Shared simple-shape geometry kit"}'
    - '// @input AssignableType_2 audio {"hint":"Sound cues"}'
    - "// @input AssignableType_3 voice {\"hint\":\"Speech-to-text for 'Say my list'\"}"
    - '// @input AssignableType_4 guide {"hint":"Route arrow + edge arrow"}'
    - '// @input AssignableType_5 card {"hint":"Start / switch / prompt / results card"}'
    - '// @input AssignableType_6 nameTag {"hint":"Item name label"}'
    - '// @input AssignableType_7 spot1 {"hint":"Spot 1 — chair seat"}'
    - '// @input AssignableType_8 spot2 {"hint":"Spot 2 — table left"}'
    - '// @input AssignableType_9 spot3 {"hint":"Spot 3 — table back-centre (hero spot)"}'
    - '// @input AssignableType_10 spot4 {"hint":"Spot 4 — table right"}'
    - '// @input AssignableType_11 spot5 {"hint":"Spot 5 — shelf top"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input string sampleListText = \"umbrella, keys, milk, call mom, gift\" {\"hint\":\"Text the 'Sample list' button sends through the list parser (route order)\"}"
    - "// @input string mixedListText = \"umbrella, keys, volcano, mobile, gift\" {\"hint\":\"Text the 'Mixed list' button sends through the same parser + matcher as voice\"}"
    - '// @input float eyeHeightCm = 160 {"hint":"User eye height in cm — places the virtual floor under the user at start", "widget":"slider", "min":120, "max":200, "step":1}'
    - "// @input float nameShowSec = 2 {\"hint\":\"Seconds an item's name shows after pinching it in study mode\", \"widget\":\"slider\", \"min\":0.5, \"max\":5, \"step\":0.1}"
    - '// @input float gazeDwellSec = 2 {"hint":"Seconds of looking at the current object that count as a pinch (0 = off)", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @input float quizSeed = 7 {"hint":"Seed for the Find-it prompt order (same seed → same order every run; each new quiz round reshuffles deterministically)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Lens Studio preview only (ignored on Specs)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Preview"}'
    - "// @input float previewStandBackCm = 320 {\"hint\":\"Preview camera starts this far behind the user's spot (the user's spot is 0.5 m from the table front). The Specs view is only ~32° wide, so from the user's spot the chair and shelf are out of frame; 320 fits the whole route with a margin. The card then floats 0.9 m in front of the camera so its text stays readable. 0 = start at the user's spot. While > 0, gaze dwell is off in the preview (the camera is a recording view, not the user's eyes).\", \"widget\":\"slider\", \"min\":0, \"max\":400, \"step\":10}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - "// @input bool alignToUserOnStart = true {\"hint\":\"Move the room so the floor is under the user's starting head pose\"}"
    - '// @input bool debugColliders {"hint":"Draw every pinch collider as a wireframe (takes effect on preview restart)"}'
    - '// @input bool runSelfTest {"hint":"Runs the scripted self-test of the 5 done criteria and prints PASS/FAIL"}'
    - '// @input bool logStateChanges = true {"hint":"Print phase changes to the log"}'
    - '// @ui {"widget":"group_end"}'
